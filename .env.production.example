# Copy to .env.production and replace all placeholder values.
# Use a URL-safe random password (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=replace-with-url-safe-random-password

# Public DNS hostname for the Caddy HTTPS edge (DNS must point to this host).
CADDY_DOMAIN=app.example.net
HOST_PORT=8787

# Generate a long unique code and at least 32 random bytes for the session secret.
SETUP_CODE=replace-with-a-long-random-owner-code
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Flux keeps its own identity, approval and audit secrets. All three must be present,
# at least 32 characters, and different from each other.
# openssl rand -hex 32
FLUX_AUTH_SECRET=replace-with-a-different-32-byte-random-secret
FLUX_APPROVAL_SECRET=replace-with-another-32-byte-random-secret
FLUX_AUDIT_KEY=replace-with-a-third-32-byte-random-secret
FLUX_OWNER_ID=owner
FLUX_OWNER_NAME=Workspace owner
# Optional: set a password to allow direct password login to the Flux API.
# The web app uses the single owner sign-in and the gateway bridges it into Flux RBAC.
FLUX_OWNER_PASSWORD=

# Keep mock until Zoho OAuth and the organization are verified.
ZOHO_MODE=mock
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Live writes stay off until explicitly enabled with a separate write credential.
ZOHO_WRITE_ENABLED=false
ZOHO_WRITE_CLIENT_ID=
ZOHO_WRITE_CLIENT_SECRET=
ZOHO_WRITE_REFRESH_TOKEN=
# Flux reads through its own slot; in live mode it reuses the proxy read credential
# unless ZOHO_READ_* is supplied explicitly.
FLUX_ZOHO_READ_FROM_PROXY=true

# Free-only routers by default. A gateway without a key/base URL is disabled.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
FLUX_COST_POLICY=free-only
FLUX_FREE_DAILY_CAP=
FLUX_BRIEFING_ENABLED=true

# Prometheus scraping token. When empty, /metrics is loopback-only.
METRICS_TOKEN=
GATEWAY_RATE_LIMIT_MAX=600
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
LOG_FORMAT=json

# Optional scheduled backup sidecar: docker compose --profile ops up -d backup
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
# Generate a distinct 32+ character key (for example: openssl rand -hex 32).
BACKUP_ENCRYPTION_KEY=replace-with-a-different-32-byte-random-secret
