{
  "servers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "penpot": {
      "type": "http",
      "url": "${env:PENPOT_MCP_URL}"
    },
    "brilliant": {
      "command": "npx",
      "args": ["-y", "@brilliant-hq/mcp"]
    },
    "figwright": {
      "command": "npx",
      "args": ["-y", "@figwright/mcp@latest"]
    },
    "anima": {
      "type": "http",
      "url": "https://api.agentgrid.io/v1/mcp"
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${input:stitchApiKey}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "stitchApiKey",
      "description": "Stitch API key",
      "password": true
    }
  ]
}
