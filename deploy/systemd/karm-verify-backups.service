[Unit]
Description=KARM OS Backup Verification
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/karm-os
EnvironmentFile=/opt/karm-os/.env.production
ExecStart=/usr/bin/node /opt/karm-os/scripts/verify-backups.mjs --retention-days=7
User=node
Group=node

[Install]
WantedBy=multi-user.target