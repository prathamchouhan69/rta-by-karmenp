{
  "dashboard": {
    "title": "KARM OS - Gateway Overview",
    "tags": ["karm", "gateway"],
    "timezone": "utc",
    "panels": [
      {
        "title": "Request Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(karm_gateway_requests_total[5m])) by (method, path)",
            "legendFormat": "{{method}} {{path}}"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [{ "format": "reqps", "label": "Requests/sec" }, { "format": "short" }]
      },
      {
        "title": "Request Latency (p50, p95, p99)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(karm_gateway_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(karm_gateway_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(karm_gateway_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [{ "format": "s", "label": "Latency" }, { "format": "short" }]
      },
      {
        "title": "Error Rate by Status Code",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(karm_gateway_requests_total[5m])) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [{ "format": "reqps", "label": "Errors/sec" }, { "format": "short" }]
      },
      {
        "title": "Active Connections",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "karm_gateway_active_connections",
            "legendFormat": "Active"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [{ "format": "short", "label": "Connections" }, { "format": "short" }]
      },
      {
        "title": "Proxy Health",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "karm_proxy_health",
            "legendFormat": "Proxy"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
            ]
          }
        }
      },
      {
        "title": "Flux Health",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "karm_flux_health",
            "legendFormat": "Flux"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
            ]
          }
        }
      },
      {
        "title": "Flux Models Configured",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "karm_flux_models",
            "legendFormat": "Models"
          }
        ]
      },
      {
        "title": "Flux Audit Entries",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "karm_flux_audit_entries",
            "legendFormat": "Entries"
          }
        ]
      },
      {
        "title": "Rate Limit Hits",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(karm_gateway_rate_limited_total[5m]))",
            "legendFormat": "Rate Limited"
          }
        ],
        "xaxis": { "mode": "time" },
        "yaxes": [{ "format": "reqps", "label": "Rate Limited/sec" }, { "format": "short" }]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s"
  }
}