{
  "name": "flux-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first Next.js interface for Flux, the AI operating system inside RTA by KARM.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${FLUX_UI_PORT:-3000}",
    "prebuild": "node scripts/verify-library-inventory.mjs",
    "build": "next build",
    "start": "next start -p ${FLUX_UI_PORT:-3000}",
    "test": "npm run test:library-selections && npm run test:receivables-aging",
    "test:library-selections": "node --experimental-strip-types --test src/lib/library-selections.test.mjs",
    "test:receivables-aging": "node --experimental-strip-types --test src/lib/receivables-aging.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
