# ---- Flux backend: server-side environment only. Never commit a real .env ----
PORT=8788
FLUX_DATA_DIR=./data
# Three different random secrets, 32+ characters each (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
FLUX_AUTH_SECRET=
FLUX_APPROVAL_SECRET=
FLUX_AUDIT_KEY=
# Comma-separated list of exact browser origins allowed to call this server (your KARM OS web origin)
FLUX_ALLOWED_ORIGINS=
# Optional read-only public web research. Exact hosts only; leave blank to disable.
FLUX_BROWSER_ALLOWED_DOMAINS=

# ---- Zoho Books (India data centre by default). Read and write credentials are separate. ----
ZOHO_DC=in
ZOHO_ORG_ID=
ZOHO_READ_CLIENT_ID=
ZOHO_READ_CLIENT_SECRET=
ZOHO_READ_REFRESH_TOKEN=
# Writes stay OFF unless you switch this on AND supply separate write credentials.
ZOHO_WRITE_ENABLED=false
ZOHO_WRITE_CLIENT_ID=
ZOHO_WRITE_CLIENT_SECRET=
ZOHO_WRITE_REFRESH_TOKEN=

# ---- Model gateways. A gateway without a key or base URL is simply disabled. ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
# free-only (default) or paid-per-use (a paid model still needs an explicit per-call approval)
FLUX_COST_POLICY=free-only
# Optional daily request cap for free models and the share kept back for the morning briefing
FLUX_FREE_DAILY_CAP=
FLUX_BRIEFING_RESERVE=5

# ---- Briefing ----
FLUX_BRIEFING_ENABLED=true
FLUX_BRIEFING_HOUR_IST=8
