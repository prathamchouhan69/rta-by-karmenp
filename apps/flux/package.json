{
  "name": "flux-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Server for Flux, the single AI agent inside RTA by KARM.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "agent-browser": "0.41.2"
  },
  "scripts": {
