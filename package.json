{
  "name": "karm-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "scan:money": "npm run scan -w apps/flux",
    "scan": "npm run scan -w apps/flux",
    "dev": "concurrently -n gateway,mock -c magenta,yellow \"npm:dev:gateway\" \"npm:dev:mock\"",
    "dev:proxy": "npm run dev -w apps/proxy",
    "dev:web": "npm run dev -w apps/web",
    "dev:gateway": "GATEWAY_HOST=127.0.0.1 FLUX_PORT=8788 FLUX_OWNER_PASSWORD=${FLUX_OWNER_PASSWORD:-karm-local-dev-owner} npm run dev -w apps/gateway",
    "dev:mock": "npm run dev -w tools/mock-zoho",
    "start": "node scripts/start-production.mjs",
    "build": "npm run build -w apps/web && npm run build -w apps/proxy && npm run build -w apps/gateway && npm run build -w tools/mock-zoho",
    "typecheck": "npm run typecheck -w apps/proxy && npm run typecheck -w apps/gateway",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs",
    "test": "npm run test -w apps/proxy && npm run test -w apps/flux && npm run test -w apps/gateway && node --test scripts/*.test.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "validate:env": "node scripts/validate-env.mjs --env-file=.env.production",
    "validate:env:fix": "node scripts/validate-env.mjs --fix --env-file=.env.production",
    "db:maintain": "node scripts/db-maintenance.mjs --all",
    "db:analyze": "node scripts/db-maintenance.mjs --analyze",
    "db:vacuum": "node scripts/db-maintenance.mjs --vacuum",
    "db:stats": "node scripts/db-maintenance.mjs --stats",
    "backup:verify": "node scripts/verify-backups.mjs",
    "backup:verify:latest": "node scripts/verify-backups.mjs --latest-only",
    "health:check": "node scripts/health-monitor.mjs",
    "logs:rotate": "node scripts/log-rotate.mjs",
    "logs:rotate:dry": "node scripts/log-rotate.mjs --dry-run",
    "deploy:prepare": "npm run validate:env && npm run build && docker compose config",
    "secrets:get": "node scripts/secrets.mjs get",
    "secrets:set": "node scripts/secrets.mjs set",
    "secrets:list": "node scripts/secrets.mjs list",
    "secrets:rotate": "node scripts/secrets.mjs rotate",
    "secrets:generate": "node scripts/secrets.mjs generate",
    "load-test": "node scripts/load-test.mjs",
    "load-test:ci": "node scripts/load-test.mjs --duration=60 --rps=20 --concurrency=10",
    "migrate:up": "npm run migrate:up -w apps/proxy",
    "migrate:down": "npm run migrate:down -w apps/proxy",
    "migrate:status": "npm run migrate:status -w apps/proxy",
    "migrate:create": "npm run migrate:create -w apps/proxy"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "concurrently": "9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.5.1"
  }
}
